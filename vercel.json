{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo \"Mil Variedades: frontend estatico + API serverless en /api\"",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__vercel_path=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api?__vercel_path=/uploads/:path*" },
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/index.html", "destination": "/pages/index.html" },
    { "source": "/catalogo.html", "destination": "/pages/catalogo.html" },
    { "source": "/login.html", "destination": "/pages/login.html" },
    { "source": "/panel.html", "destination": "/pages/panel.html" }
  ]
}
