# ============================================
# PLANTILLA de variables de entorno.
# Copia este archivo, renómbralo a ".env" y
# reemplaza los valores vacíos con tus datos reales.
# Este archivo SÍ se sube a Git (no tiene secretos).
# El .env real NUNCA se sube a Git.
# ============================================

# Puerto donde va a correr el backend en tu máquina
PORT=4000

# development = tu computador | production = servidor final
NODE_ENV=development

# --- Conexión a MySQL ---
   DB_HOST=127.0.0.1
   DB_PORT=3306
   DB_USER=milvariedades_app
   DB_PASSWORD=15384617Juan.
   
# --- Autenticación ---
# JWT_SECRET debe ser un texto largo y aleatorio (lo generamos abajo)
JWT_SECRET=040e5446e435b9536846443a4d115a47d934531d90b9b2be104dc6cf36ba90fc51e3174ba115608faf53612fde9b6efc806006e0c6640152db71d2424351f8e1
JWT_EXPIRES_IN=1d

# --- CORS: desde dónde puede llamar el frontend a esta API ---
# En desarrollo local con Live Server de VS Code suele ser este puerto:
CORS_ORIGIN=http://127.0.0.1:5500

# --- Rate limiting (anti fuerza bruta / anti abuso) ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100

# --- WhatsApp del negocio ---
WHATSAPP_NUMBER=573001234567
